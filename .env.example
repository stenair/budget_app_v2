# Redbark API v2 — server only. Never prefix this with NEXT_PUBLIC_.
REDBARK_API_KEY=
REDBARK_VERSION=2026-10-01.wattle

# Clerk authentication. Configure both values to enable live mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated allowlist. Exactly these household members can access live data.
HOUSEHOLD_EMAILS=you@example.com,partner@example.com

# Local development escape hatch. Keep false in deployed environments.
ALLOW_LIVE_DATA_WITHOUT_AUTH=false

# Production requires durable PostgreSQL and a 32 byte encryption key in hex.
DATABASE_URL=
DATA_ENCRYPTION_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
